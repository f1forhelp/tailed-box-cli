          <mxGeometry height="40" width="740" x="330" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ov_subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#4B5563;align=center;" value="One-time enrollment creates trust. Enrolled peers then use signed ephemeral handshakes and encrypted control messages." vertex="1">
          <mxGeometry height="30" width="980" x="210" y="75" as="geometry" />
        </mxCell>
        <mxCell id="ov_master" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF2FF;strokeColor=#4338CA;fontSize=17;fontStyle=1;" value="Master Node" vertex="1">
          <mxGeometry height="55" width="330" x="80" y="150" as="geometry" />
        </mxCell>
        <mxCell id="ov_worker" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#047857;fontSize=17;fontStyle=1;" value="Worker Node" vertex="1">
          <mxGeometry height="55" width="330" x="990" y="150" as="geometry" />
        </mxCell>
        <mxCell id="ov_master_identity" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4338CA;fontSize=13;" value="Local Identity&#xa;node ID&#xa;Ed25519 public/private key&#xa;private key stored 0600" vertex="1">
          <mxGeometry height="100" width="330" x="80" y="240" as="geometry" />
        </mxCell>
        <mxCell id="ov_worker_identity" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#047857;fontSize=13;" value="Local Identity&#xa;node ID&#xa;Ed25519 public/private key&#xa;private key stored 0600" vertex="1">
          <mxGeometry height="100" width="330" x="990" y="255" as="geometry" />
        </mxCell>
        <mxCell id="ov_master_state" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=13;" value="Master Private State&#xa;invites with secret hashes&#xa;trusted worker records&#xa;runtime peer observations" vertex="1">
          <mxGeometry height="110" width="330" x="80" y="370" as="geometry" />
        </mxCell>
        <mxCell id="ov_worker_state" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=13;" value="Worker Private State&#xa;pinned master trust&#xa;trusted peer records&#xa;runtime peer observations" vertex="1">
          <mxGeometry height="110" width="330" x="990" y="380" as="geometry" />
        </mxCell>
        <mxCell id="ov_join" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=16;fontStyle=1;" value="One-Time Join" vertex="1">
          <mxGeometry height="60" width="330" x="535" y="150" as="geometry" />
        </mxCell>
        <mxCell id="ov_join_details" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=13;" value="Invite code pins master identity&#xa;worker sends join request&#xa;master sends signed challenge&#xa;worker proves code secret&#xa;master sends signed accept" vertex="1">
          <mxGeometry height="130" width="330" x="535" y="240" as="geometry" />
        </mxCell>
        <mxCell id="ov_trust" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=16;fontStyle=1;" value="Persisted Trust" vertex="1">
          <mxGeometry height="60" width="330" x="535" y="420" as="geometry" />
        </mxCell>
        <mxCell id="ov_trust_details" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=13;" value="Master trusts worker identity&#xa;Worker trusts pinned master identity&#xa;Invite is marked used&#xa;Original code is not reused" vertex="1">
          <mxGeometry height="115" width="330" x="535" y="500" as="geometry" />
        </mxCell>
        <mxCell id="ov_session" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=16;fontStyle=1;" value="Enrolled Secure Session" vertex="1">
          <mxGeometry height="60" width="330" x="535" y="655" as="geometry" />
        </mxCell>
        <mxCell id="ov_session_details" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=13;" value="Ed25519 transcript signatures&#xa;X25519 ephemeral key agreement&#xa;HKDF-SHA256 session keys&#xa;AES-256-GCM encrypted packets&#xa;replay window rejects duplicates" vertex="1">
          <mxGeometry height="125" width="330" x="535" y="745" as="geometry" />
        </mxCell>
        <mxCell id="ov_revoke" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=13;fontStyle=1;" value="Explicit Revocation&#xa;remove peer trust&#xa;future handshakes fail&#xa;new invite required" vertex="1">
          <mxGeometry height="120" width="330" x="990" y="630" as="geometry" />
        </mxCell>
        <mxCell id="ov_e1" edge="1" parent="1" source="ov_master_state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#D97706;fontSize=11;" target="ov_join_details" value="create invite">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov_e2" edge="1" parent="1" source="ov_worker_identity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#D97706;fontSize=11;" target="ov_join_details" value="join request">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov_e3" edge="1" parent="1" source="ov_join_details" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#7C3AED;fontSize=11;" target="ov_trust" value="write trust">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov_e4" edge="1" parent="1" source="ov_trust_details" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#7C3AED;fontSize=11;" target="ov_master_state" value="trusted worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov_e5" edge="1" parent="1" source="ov_trust_details" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#7C3AED;fontSize=11;" target="ov_worker_state" value="pinned master">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov_e6" edge="1" parent="1" source="ov_trust_details" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#2563EB;fontSize=11;" target="ov_session" value="normal reconnect path">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
